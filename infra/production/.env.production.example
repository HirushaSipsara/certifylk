# Public URL and immutable release identity
DOMAIN_NAME=certifylk.example.com
GHCR_OWNER=hirushasipsara
IMAGE_TAG=0000000000000000000000000000000000000000

# PostgreSQL. Use a long URL-safe random password and keep both values consistent.
POSTGRES_DB=certifylk
POSTGRES_USER=certifylk
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgresql+psycopg://certifylk:CHANGE_ME_LONG_RANDOM_URL_SAFE_PASSWORD@postgres:5432/certifylk

# Local persistent host paths used for TLS, ACME challenges, state, and backups.
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot
RELEASE_STATE_DIR=/var/lib/certifylk/releases
BACKUP_DIR=/var/backups/certifylk
BACKUP_RETENTION_DAYS=30
POSTGRES_VOLUME_NAME=certifylk-production-postgres-data
UPLOADS_VOLUME_NAME=certifylk-production-uploads

# Application settings. Mock mode remains supported; use gemini only with a key.
MAX_IMAGE_MB=8
MAX_PDF_MB=12
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
ALLOW_AI_FALLBACK=false
LOG_LEVEL=INFO

# Public health-check behavior.
HEALTHCHECK_ATTEMPTS=20
HEALTHCHECK_DELAY_SECONDS=5
